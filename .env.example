# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleanaglow?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_ADMIN_URL="http://localhost:3001"

# OAuth (Optional for local dev)
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
APPLE_CLIENT_ID="apple-client-id"
APPLE_CLIENT_SECRET="apple-client-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."
STRIPE_PRICE_ID_WEEKLY="price_weekly_test"
STRIPE_PRICE_ID_BIWEEKLY="price_biweekly_test"
STRIPE_PRICE_ID_MONTHLY="price_monthly_test"

# Resend / Email
