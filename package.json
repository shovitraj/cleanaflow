{
  "name": "cleanaglow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "pnpm --filter @cleanaglow/db db:push",
    "db:generate": "pnpm --filter @cleanaglow/db db:generate",
    "db:seed": "pnpm --filter @cleanaglow/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.15.0"
}
